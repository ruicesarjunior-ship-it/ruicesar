# Chave de API da Anthropic (obrigatória)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar (opcional, padrão: claude-opus-4-6)
CLAUDE_MODEL=claude-opus-4-6

# Pastas (opcionais, padrão: relativo ao projeto)
PASTA_ENTRADA=entrada
PASTA_SAIDA=saida
PASTA_MODELOS=modelos
PASTA_PROCESSADOS=processados

# Cidade do órgão para o fecho do documento
CIDADE_ORGAO=Salvador
